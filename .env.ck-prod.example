# ── Network ───────────────────────────────────────────────────────────────────
# Port exposed on the host. Container always listens on CK_CONTAINER_PORT.
CK_HOST_PORT=3484
CK_CONTAINER_PORT=3484

# ── Storage ───────────────────────────────────────────────────────────────────
# Absolute path on the host where operator repos live.
# Mounted read-write at the same path inside the container so absolute paths in
# git worktrees and workspace config remain valid.
# The container node user (uid 1000) must have write access to this path:
#   sudo chown -R 1000:1000 /srv/projects
CK_PROJECTS_ROOT=/srv/projects

# ── Agent tool binaries ───────────────────────────────────────────────────────
# Home directory of the user whose NVM and .local installs hold agent CLIs
# (claude, codex, etc.). Both directories are bind-mounted read-only.
CK_HOST_HOME=/home/deploy

# Active NVM node version whose bin dir is added to PATH inside the container.
# Run `node --version` on the host to find the right value.
# Update this when you upgrade the node version that owns your agent CLIs.
CK_NVM_NODE_VERSION=v24.14.1

# ── Telemetry (optional) ──────────────────────────────────────────────────────
# Leave blank to disable PostHog telemetry.
POSTHOG_KEY=
POSTHOG_HOST=https://data.cline.bot
