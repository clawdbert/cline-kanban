[Unit]
Description=Cline Kanban (ck-prod)
Documentation=https://github.com/cline/kanban
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ck-prod
EnvironmentFile=/opt/ck-prod/.env.ck-prod
ExecStart=podman-compose up --remove-orphans
ExecStop=podman-compose down
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=default.target
